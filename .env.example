# Settings for `docker compose up` (docker-compose.yml). Copy to .env and edit.

# Public hostname of the web app. Caddy obtains a TLS certificate for it automatically.
SITE_DOMAIN=tempmail.example.com

# Domain that receives mail. Its MX record must point at this server.
# Can be the same as SITE_DOMAIN or a separate one (e.g. mail.example.com).
MAIL_DOMAIN=tempmail.example.com
# Hostname announced in the SMTP greeting; should match the server's reverse DNS (defaults to MAIL_DOMAIN).
SMTP_HOSTNAME=

# Database. Use a long random password with URL-safe characters only (letters, digits, - _).
POSTGRES_USER=tempmail
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=tempmail

# Public repository containing the source of the version you deploy. The AGPL-3.0 requires
# offering it to users if you run a modified version. Shown in the site footer.
SOURCE_URL=https://github.com/SheerWill007/TemptingMail

# Extra names nobody may claim (comma-separated). admin, postmaster, hostmaster, webmaster, abuse,
# root, security, support, billing, info, noreply and similar are always reserved.
RESERVED_NAMES=
SMTP_MAX_CONNECTIONS_PER_MINUTE=60

MAILBOX_TTL_HOURS=24
MAILBOX_CREATE_LIMIT_PER_HOUR=20
API_RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info

# Optional analytics
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
