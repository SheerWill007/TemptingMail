# ---------------------------------------------------------------------------
# Temp Mail backend. Copy to .env and adjust. Only DATABASE_URL and MAIL_DOMAIN are required.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL connection string
DATABASE_URL=postgresql://tempmail:tempmail@localhost:5432/tempmail

# Domain that receives mail (its MX record must point at this server)
MAIL_DOMAIN=localhost

# --- HTTP API ----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3001
# Only needed if browsers call the API directly from another origin (the frontend
# normally proxies /api on its own origin). Comma-separated, or * for any.
CORS_ORIGINS=
# Express "trust proxy": number of reverse-proxy hops in front of the API (e.g. 1),
# true, false, or a subnet list. Required for correct per-IP rate limiting behind a proxy.
TRUST_PROXY=loopback
MAILBOX_CREATE_LIMIT_PER_HOUR=20
API_RATE_LIMIT_PER_MINUTE=120

# --- SMTP --------------------------------------------------------------------
SMTP_ENABLED=true
SMTP_HOST=0.0.0.0
# Use 2525 locally; in production expose port 25 (Docker maps 25 -> 2525 so the process needs no root)
SMTP_PORT=2525
# Hostname announced in the SMTP greeting (defaults to MAIL_DOMAIN)
SMTP_HOSTNAME=
SMTP_MAX_MESSAGE_BYTES=10485760
SMTP_MAX_RECIPIENTS=50
# Optional STARTTLS certificate (PEM files)
SMTP_TLS_KEY_PATH=
SMTP_TLS_CERT_PATH=

# --- Data lifecycle ----------------------------------------------------------
MAILBOX_TTL_HOURS=24
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_MINUTES=15

# --- Optional analytics (no addresses or content are ever sent) --------------
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
