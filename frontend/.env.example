# LOCAL DEVELOPMENT settings: copy to .env.local. Production values for temp.willx.tech live in
# .env.production (public defaults) and the root .env (Docker); you don't need to edit this for production.

# Where the Next.js server proxies /api requests (server-side, read at runtime).
API_URL=http://localhost:3001

# Public URL of this site (used for metadata, robots.txt and sitemap). Read at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: shown before /api/config loads. The backend's MAIL_DOMAIN is the source of truth.
NEXT_PUBLIC_MAIL_DOMAIN=localhost

# Optional: call the API directly from the browser instead of through /api (requires CORS_ORIGINS on the backend).
# NEXT_PUBLIC_API_URL=https://api.example.com

# Link to the source code of the version you deploy (required by the AGPL if you modify it).
NEXT_PUBLIC_SOURCE_URL=https://github.com/SheerWill007/TemptingMail

# Optional analytics
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
