# ===========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE CONFIGURATION (REQUIRED)
# ===========================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database?schema=public
# Example: postgresql://tempmail:securepassword@localhost:5432/tempmail
DATABASE_URL=postgresql://username:password@host:port/database

# ===========================================
# SERVER CONFIGURATION
# ===========================================
# API server port (default: 3001)
API_PORT=3001

# SMTP server port (25 for production, 2525 for development/testing)
# Note: Port 25 requires root/admin privileges
SMTP_PORT=25

# ===========================================
# DOMAIN CONFIGURATION (REQUIRED)
# ===========================================
# Your email domain (e.g., temp.yourdomain.com)
# Users will get addresses like: username@temp.yourdomain.com
SMTP_DOMAIN=temp.yourdomain.com
MAIL_DOMAIN=temp.yourdomain.com

# ===========================================
# CORS CONFIGURATION (REQUIRED)
# ===========================================
# Frontend URL(s) that can access the API
# For single domain: https://temp.yourdomain.com
# For multiple domains: https://domain1.com,https://domain2.com
CORS_ORIGIN=https://temp.yourdomain.com

# Legacy frontend URL variable (can be same as CORS_ORIGIN)
FRONTEND_URL=https://temp.yourdomain.com

# ===========================================
# ENVIRONMENT
# ===========================================
NODE_ENV=production

# ===========================================
# CLEANUP SERVICE
# ===========================================
# Enable automatic cleanup of expired data (true/false)
CLEANUP_ENABLED=true

# Designate this instance as cleanup leader (true/false)
# Only one instance should be leader in multi-server setup
CLEANUP_LEADER=true

# Cleanup interval in milliseconds (default: 21600000 = 6 hours)
CLEANUP_INTERVAL_MS=21600000

# Initial delay before first cleanup (default: 300000 = 5 minutes)
CLEANUP_START_DELAY_MS=300000

# Random jitter percentage for cleanup timing (default: 0.10 = 10%)
CLEANUP_JITTER_PCT=0.10

# ===========================================
# RATE LIMITING (OPTIONAL)
# ===========================================
# Rate limit window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window (default: 100)
RATE_LIMIT_MAX=100

# ===========================================
# ANALYTICS (OPTIONAL)
# ===========================================
# PostHog API key for analytics (leave empty to disable)
POSTHOG_KEY=

# PostHog host URL (default: https://app.posthog.com)
POSTHOG_HOST=https://app.posthog.com

# Alternative PostHog key variable name
NEXT_PUBLIC_POSTHOG_KEY=

# Alternative PostHog host variable name
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
