# LOCAL DEVELOPMENT settings: copy to .env. In production set these as real environment variables
# (Vercel project settings, Docker). Variables named NUXT_PUBLIC_* are visible to browsers.

# Where the Nuxt server proxies /api requests (server-side, read at runtime).
NUXT_API_URL=http://localhost:3001

# Public URL of this site (metadata, robots.txt, sitemap).
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: shown before /api/config loads. The backend's MAIL_DOMAIN is the source of truth.
NUXT_PUBLIC_MAIL_DOMAIN=localhost

# Optional: backend origin that browsers reach directly for live updates (SSE) and downloads, e.g.
# https://temp-mail-api.onrender.com. Requires CORS_ORIGINS=<this site's origin> on the backend.
# Leave empty to send everything through the /api proxy.
NUXT_PUBLIC_API_BASE=

# Link to the source code of the version you deploy (required by the AGPL if you modify it).
NUXT_PUBLIC_SOURCE_URL=https://github.com/SheerWill007/TemptingMail

# Optional analytics
NUXT_PUBLIC_POSTHOG_KEY=
NUXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
